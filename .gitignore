# R y entorno
.Rproj.user/
.Rhistory
.RData
.Ruserdata
_targets/
renv/library/
renv/staging/
renv/local/

# Datos que se regeneran con el pipeline
datos/brutos/
datos/intermedios/
datos/portales/

# Capas y salidas pesadas
*.pmtiles

# Exportación del pipeline para la web (unos 8.500 ficheros y 75 MB): se regenera y se publica
# con el mapa base desde un release. La muestra con valores inventados sí va en git.
web/datos/*
!web/datos/ejemplo/
# Ficheros del release (empaquetar_publicacion(), docs/publicacion.md), páginas «Método» y
# «Datos», que genera el flujo de Pages desde docs/, y la copia local de las descargas
publicacion/
web/metodo.html
web/method.html
web/datos.html
web/data.html
web/descargas/
geo/brutos/
*.zip

# Salidas de una redirección mal escrita en la consola (p. ej. «> 0» en lugar de «2>&1»): el
# fichero «0» de la raíz llegó así a git el 8-nov-2026
/[0-9]

# Secretos
.Renviron
.env

# Sistema
.DS_Store
Thumbs.db
desktop.ini
